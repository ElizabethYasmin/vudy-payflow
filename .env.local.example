# Copia este archivo a .env.local y completa tus valores reales.
# .env.local NUNCA se sube al repo (ya está en .gitignore).

# Clave generada en Vudy > Perfil > Acceso de Desarrollador > Crear Clave de API
VUDY_API_KEY=

# Necesarios para el Patrón B de autenticación (POST /channel/vudy/send/create).
# Si no los tienes todavía, déjalos vacíos: la app cae automáticamente en
# modo simulado (VUDY_MOCK_MODE) para esa llamada.
VUDY_PROFILE_ID=
VUDY_TEAM_ID=

# Wallet propia usada para consultar el balance (GET /v1/wallet/portfolio).
VUDY_WALLET_ADDRESS=0x38D6...a75a

# Opcional: fuerza el modo simulado aunque haya credenciales (true/false).
VUDY_MOCK_MODE=false

# Opcional: cambiar si Vudy confirma una URL base distinta.
VUDY_BASE_URL=https://api.vudy.app

# Postgres (Vercel Storage / Neon). Copia la cadena de conexión desde
# Vercel > tu proyecto > Storage > tu base de datos > Quickstart/.env.local.
# Si usas Docker en local, sería algo como:
# postgres://postgres:1234@localhost:5432/postgres
POSTGRES_URL=
